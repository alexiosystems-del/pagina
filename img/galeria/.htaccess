# las fotos subidas nunca se ejecutan como codigo
Options -ExecCGI
RemoveHandler .php .phtml .php5 .php7 .php8
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
</FilesMatch>
